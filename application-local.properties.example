# Copy to application-local.properties and adjust if needed.
# Loaded when ENVIRONMENT=local. Environment variables override these values.
server.addr=:8080

db.host=localhost
db.port=5432
db.user=broadcast
db.password=broadcast
db.name=broadcast
db.sslmode=disable

# OBS WebSocket (OBS > Tools > WebSocket Server Settings). Prefer OBS_PASSWORD in the environment
# so the password is not stored in a file.
obs.addr=localhost:4455
obs.password=
# Scene where saved replays play, and the media source inside it. Scene and source names must
# differ: OBS shares one namespace for both.
obs.replay.scene=Replay
obs.replay.source=Replay Clip
# Media source in the replay scene that plays before each clip.
obs.replay.intro=Replay Intro
# Media source in the replay scene that plays after the clip, to return to the live picture.
obs.replay.live=Live
